  "endonym": [{ "value": "Ammenulle wellu", "gloss": "the sheet of the carrying out" }],
  "accessionCode": "CCX-A-14823",
  "description": [
    {
      "value": "<p>A close-woven sheet of split plate fibre, two metres by nine tenths, with cord loops worked into the weave at the ankles and the shoulders. Sheets are woven for the purpose and are not used for anything else, and this one was never used: it was woven for a holder who was still alive when the survey left and was given over as a spare. The weave is even and slightly loose at one end where the weaver ran short. It is the only object from this practice in any collection, and it will be the only one.</p>",
      "inLanguage": [{ "id": ["core.peerdb.org", "LANGUAGE", "en-GB"] }]
    }
  ],
