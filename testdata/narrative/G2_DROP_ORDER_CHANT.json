  "description": [
    {
      "value": "<p>The full sequence in which the drops are opened, held in metre so that no line can be taken out without the loss being audible. It is recited once at each assembly by one person, standing, without prompting.</p>",
      "inLanguage": [{ "id": ["core.peerdb.org", "LANGUAGE", "en-GB"] }]
    }
