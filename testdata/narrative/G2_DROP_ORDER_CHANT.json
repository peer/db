  "recordedBy": [{ "id": ["xeno.peerdb.org", "RESEARCHER", "RES_BEKELE"] }, { "id": ["xeno.peerdb.org", "RESEARCHER", "RES_BRANDT"] }],
  "recordedAt": { "id": ["xeno.peerdb.org", "SITE", "G2_TURNING_GROUND"] },
  "recordedOn": { "time": "2277-01-01T00:00:00Z", "precision": "y" },
  "inSystem": [{ "id": ["xeno.peerdb.org", "COMMUNICATION_SYSTEM", "G2_PLATE_LIGHT"] }],
  "content": [
    {
      "value": "<blockquote><p>High one first, and count into the wind.</p><p>Fourth and not third; the third is answered and stays shut.</p><p>Ninth, and wait on the ninth until the ninth is standing.</p><p>Second, sixth, eleventh, and nothing between them.</p><p>Then the long gap, which is opened by whoever is nearest and closed by whoever opened it.</p><p>Then the third, if the wall has changed its mind.</p></blockquote>",
      "inLanguage": [{ "id": ["core.peerdb.org", "LANGUAGE", "en-GB"] }]
    }
